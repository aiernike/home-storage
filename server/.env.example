# 家庭收纳同步服务 - 环境配置
# 复制为 .env 后按需修改，docker compose 会自动读取

# 服务端口（如果 8787 被占用可改这里，同时要改 docker-compose.yml 的端口映射）
PORT=8787

# 数据库配置
DB_NAME=homestorage
DB_USER=home
# 请务必修改为强密码
DB_PASSWORD=home123456

# 令牌签名密钥，请务必改成一串随机字符
JWT_SECRET=please-change-this-to-a-random-string

# 是否允许注册新账号。账号建好后建议改为 false
ALLOW_REGISTER=true

# 时区
TZ=Asia/Shanghai
